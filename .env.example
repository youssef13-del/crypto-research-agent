# Credential-free safe mode keeps provider evidence and deterministic analysis fallbacks.
LLM_PROVIDER=disabled
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=0
GROQ_MAX_TOKENS=2500
GROQ_MIN_REQUEST_INTERVAL_SECONDS=2.1
GROQ_RATE_LIMIT_MAX_WAIT_SECONDS=10

# Optional CoinGecko demo API key for fundamentals requests.
COINGECKO_API_KEY=

# Public, keyless, open-source DeFi protocol data.
DEFILLAMA_BASE_URL=https://api.llama.fi

# Public, keyless Coin Metrics Community network data (non-commercial license).
COINMETRICS_BASE_URL=https://community-api.coinmetrics.io/v4

# Public, keyless Binance USD-M perpetual-futures market data.
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com

# Forecast training and diagnostic quality thresholds.
MINIMUM_TRAINING_SAMPLES=200
MINIMUM_VALIDATION_SAMPLES=50
TIME_SERIES_FOLDS=5
MINIMUM_MAE_IMPROVEMENT=0.02
MINIMUM_DIRECTIONAL_ACCURACY=0.52
MAXIMUM_ABSOLUTE_FORECAST_RETURN=0.20
MAXIMUM_INTERVAL_WIDTH=0.40
# Durable SQLite storage. When omitted, ChainScope uses a database in
# the operating system's per-user application-data directory.
DATABASE_URL=
RESEARCH_RETENTION_DAYS=365
