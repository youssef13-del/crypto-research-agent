LLM_PROVIDER = "disabled"
GROQ_API_KEY = ""
GROQ_MODEL = "openai/gpt-oss-120b"
GROQ_BASE_URL = "https://api.groq.com/openai/v1"
GROQ_TIMEOUT_SECONDS = 30
GROQ_MAX_RETRIES = 0
GROQ_MAX_TOKENS = 2500
GROQ_MIN_REQUEST_INTERVAL_SECONDS = 2.1
GROQ_RATE_LIMIT_MAX_WAIT_SECONDS = 10
COINGECKO_API_KEY = ""
DEFILLAMA_BASE_URL = "https://api.llama.fi"
COINMETRICS_BASE_URL = "https://community-api.coinmetrics.io/v4"
BINANCE_FUTURES_BASE_URL = "https://fapi.binance.com"
DATABASE_URL = ""
RESEARCH_RETENTION_DAYS = 365
MINIMUM_TRAINING_SAMPLES = 200
MINIMUM_VALIDATION_SAMPLES = 50
TIME_SERIES_FOLDS = 5
MINIMUM_MAE_IMPROVEMENT = 0.02
MINIMUM_DIRECTIONAL_ACCURACY = 0.52
MAXIMUM_ABSOLUTE_FORECAST_RETURN = 0.20
MAXIMUM_INTERVAL_WIDTH = 0.40

# Create an Auth0 Regular Web Application before launching the Streamlit UI.
# Configure both a Google social connection and an Auth0 database connection in Universal Login.
# Register the exact redirect_uri below in BOTH the application's Allowed Callback URLs and
# Allowed Logout URLs. Streamlit sends this URI to Auth0 as post_logout_redirect_uri.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-long-random-secret"

[auth.auth0]
client_id = "replace-with-auth0-client-id"
client_secret = "replace-with-auth0-client-secret"
server_metadata_url = "https://YOUR_AUTH0_DOMAIN/.well-known/openid-configuration"
